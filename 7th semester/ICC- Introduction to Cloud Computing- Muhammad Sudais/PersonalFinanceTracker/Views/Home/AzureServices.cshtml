@{
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="relative bg-gradient-to-br from-emerald-950 via-emerald-900 to-gray-900 rounded-3xl p-6 sm:p-10 border border-emerald-700/30 shadow-lg overflow-hidden">
	<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(16,185,129,0.15),_transparent_60%)] pointer-events-none"></div>

	<h1 class="text-2xl sm:text-3xl font-bold mb-8 sm:mb-10 flex items-center gap-2 text-white">
		<svg data-lucide="cloud" class="w-6 sm:w-7 h-6 sm:h-7 text-emerald-400"></svg>
		Azure Services Used
	</h1>
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 relative z-10">
		<div class="group bg-white/10 backdrop-blur-xl p-5 sm:p-6 rounded-2xl border border-white/10 hover:border-emerald-500/40 shadow-lg hover:shadow-emerald-500/10 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02]">
			<div class="flex items-center gap-3 mb-3">
				<div class="p-3 bg-emerald-500/20 rounded-full group-hover:bg-emerald-500/30 transition">
					<svg data-lucide="globe" class="w-5 h-5 text-emerald-400"></svg>
				</div>
				<h3 class="font-semibold text-lg text-white">Azure App Service</h3>
			</div>
			<p class="text-gray-300 text-sm leading-relaxed">
				Hosts the frontend web app with built-in load balancing, scaling, and HTTPS support.
			</p>
		</div>
		<div class="group bg-white/10 backdrop-blur-xl p-5 sm:p-6 rounded-2xl border border-white/10 hover:border-emerald-500/40 shadow-lg hover:shadow-emerald-500/10 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02]">
			<div class="flex items-center gap-3 mb-3">
				<div class="p-3 bg-emerald-500/20 rounded-full group-hover:bg-emerald-500/30 transition">
					<svg data-lucide="function-square" class="w-5 h-5 text-emerald-400"></svg>
				</div>
				<h3 class="font-semibold text-lg text-white">Azure Functions</h3>
			</div>
			<p class="text-gray-300 text-sm leading-relaxed">
				Serverless compute for transaction processing and analytics tasks.
			</p>
		</div>
		<div class="group bg-white/10 backdrop-blur-xl p-5 sm:p-6 rounded-2xl border border-white/10 hover:border-emerald-500/40 shadow-lg hover:shadow-emerald-500/10 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02]">
			<div class="flex items-center gap-3 mb-3">
				<div class="p-3 bg-emerald-500/20 rounded-full group-hover:bg-emerald-500/30 transition">
					<svg data-lucide="database" class="w-5 h-5 text-emerald-400"></svg>
				</div>
				<h3 class="font-semibold text-lg text-white">Azure Cosmos DB</h3>
			</div>
			<p class="text-gray-300 text-sm leading-relaxed">
				NoSQL database for scalable storage of user profiles, transactions, and budgets.
			</p>
		</div>
		<div class="group bg-white/10 backdrop-blur-xl p-5 sm:p-6 rounded-2xl border border-white/10 hover:border-emerald-500/40 shadow-lg hover:shadow-emerald-500/10 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02]">
			<div class="flex items-center gap-3 mb-3">
				<div class="p-3 bg-emerald-500/20 rounded-full group-hover:bg-emerald-500/30 transition">
					<svg data-lucide="folder" class="w-5 h-5 text-emerald-400"></svg>
				</div>
				<h3 class="font-semibold text-lg text-white">Azure Blob Storage</h3>
			</div>
			<p class="text-gray-300 text-sm leading-relaxed">
				Stores user-uploaded receipts and files with secured SAS access.
			</p>
		</div>
		<div class="group bg-white/10 backdrop-blur-xl p-5 sm:p-6 rounded-2xl border border-white/10 hover:border-emerald-500/40 shadow-lg hover:shadow-emerald-500/10 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02]">
			<div class="flex items-center gap-3 mb-3">
				<div class="p-3 bg-emerald-500/20 rounded-full group-hover:bg-emerald-500/30 transition">
					<svg data-lucide="lock" class="w-5 h-5 text-emerald-400"></svg>
				</div>
				<h3 class="font-semibold text-lg text-white">Azure AD & Key Vault</h3>
			</div>
			<p class="text-gray-300 text-sm leading-relaxed">
				Manages secure authentication and protects sensitive configuration secrets.
			</p>
		</div>
		<div class="group bg-white/10 backdrop-blur-xl p-5 sm:p-6 rounded-2xl border border-white/10 hover:border-emerald-500/40 shadow-lg hover:shadow-emerald-500/10 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02]">
			<div class="flex items-center gap-3 mb-3">
				<div class="p-3 bg-emerald-500/20 rounded-full group-hover:bg-emerald-500/30 transition">
					<svg data-lucide="activity" class="w-5 h-5 text-emerald-400"></svg>
				</div>
				<h3 class="font-semibold text-lg text-white">Monitoring & DevOps</h3>
			</div>
			<p class="text-gray-300 text-sm leading-relaxed">
				Application Insights and Azure Monitor track performance and logs. Azure DevOps automates CI/CD.
			</p>
		</div>
	</div>
	<div class="mt-10 sm:mt-12 text-center relative z-10">
		<a href="/Home/Intro" class="px-4 sm:px-5 py-2 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white inline-flex items-center gap-2 transition text-sm sm:text-base">
			<svg data-lucide="arrow-left" class="w-4 h-4"></svg> Back to Intro
		</a>
	</div>
</section>

<script>lucide.createIcons();</script>
