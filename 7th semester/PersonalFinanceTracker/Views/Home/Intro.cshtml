						</div>
					</div>
					<div class="absolute-member" style="--i:1;">
						<div class="member-card">
							<svg data-lucide="user" class="w-6 h-6 text-emerald-400 mb-1"></svg>
							<h4>Hafsah</h4>
						</div>
					</div>
					<div class="absolute-member" style="--i:2;">
						<div class="member-card">
							<svg data-lucide="user" class="w-6 h-6 text-emerald-400 mb-1"></svg>
							<h4>Umair</h4>
						</div>
					</div>
					<div class="absolute-member" style="--i:3;">
						<div class="member-card">
							<svg data-lucide="user" class="w-6 h-6 text-emerald-400 mb-1"></svg>
							<h4>Shahzaib</h4>
						</div>
					</div>
					<div class="absolute-member" style="--i:4;">
						<div class="member-card">
							<svg data-lucide="user" class="w-6 h-6 text-emerald-400 mb-1"></svg>
							<h4>Naveed</h4>
						</div>
					</div>
					<div class="absolute-member" style="--i:5;">
						<div class="member-card">
							<svg data-lucide="user" class="w-6 h-6 text-emerald-400 mb-1"></svg>
							<h4>Faiq</h4>
						</div>
					</div>
				</div>
			</div>
			<div class="sm:hidden grid grid-cols-1 gap-4 mt-6">
				<div class="bg-gradient-to-r from-emerald-600 to-emerald-400 text-white p-4 rounded-2xl text-center shadow-lg">
					<h3 class="text-lg font-bold">Mustafa</h3>
					<p class="text-xs uppercase tracking-widest text-emerald-100 font-semibold">Team Leader</p>
				</div>
				<div class="grid grid-cols-2 gap-4">
					<div class="bg-white/10 p-3 rounded-xl border border-white/10 text-center shadow-sm hover:bg-white/20 transition text-sm text-white flex flex-col items-center justify-center">
						<svg data-lucide="user" class="w-5 h-5 text-emerald-400 mb-1"></svg>Laiba
					</div>
					<div class="bg-white/10 p-3 rounded-xl border border-white/10 text-center shadow-sm hover:bg-white/20 transition text-sm text-white flex flex-col items-center justify-center">
						<svg data-lucide="user" class="w-5 h-5 text-emerald-400 mb-1"></svg>Hafsah
					</div>
					<div class="bg-white/10 p-3 rounded-xl border border-white/10 text-center shadow-sm hover:bg-white/20 transition text-sm text-white flex flex-col items-center justify-center">
						<svg data-lucide="user" class="w-5 h-5 text-emerald-400 mb-1"></svg>Umair
					</div>
					<div class="bg-white/10 p-3 rounded-xl border border-white/10 text-center shadow-sm hover:bg-white/20 transition text-sm text-white flex flex-col items-center justify-center">
						<svg data-lucide="user" class="w-5 h-5 text-emerald-400 mb-1"></svg>Shahzaib
					</div>
					<div class="bg-white/10 p-3 rounded-xl border border-white/10 text-center shadow-sm hover:bg-white/20 transition text-sm text-white flex flex-col items-center justify-center">
						<svg data-lucide="user" class="w-5 h-5 text-emerald-400 mb-1"></svg>Naveed
					</div>
					<div class="bg-white/10 p-3 rounded-xl border border-white/10 text-center shadow-sm hover:bg-white/20 transition text-sm text-white flex flex-col items-center justify-center">
						<svg data-lucide="user" class="w-5 h-5 text-emerald-400 mb-1"></svg>Faiq
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="relative bg-gradient-to-br from-emerald-950 via-emerald-900 to-gray-900 p-6 sm:p-10 rounded-3xl border border-emerald-700/30 shadow-lg overflow-hidden">
		<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(16,185,129,0.12),_transparent_50%)] pointer-events-none"></div>
		<div class="flex items-center gap-3 mb-5">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
