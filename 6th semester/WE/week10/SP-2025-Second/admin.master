<%@ Master Language="C#" AutoEventWireup="true" CodeFile="admin.master.cs" Inherits="admin" %>


<!DOCTYPE html>
<html lang="en">
<head>
    <title>My Site</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: #343a40;
            color: white;
            padding-top: 60px;
        }
        .sidebar a {
            padding: 10px 15px;
            text-decoration: none;
            color: white;
            display: block;
        }
        .sidebar a:hover {
            background: #495057;
        }
        .content {
             margin-left: 260px; /* Adjust based on sidebar width */
    padding: 80px 20px 20px; /* Push content below navbar */
        }
        .navbar {
            position: fixed;
            width: 100%;
            z-index: 1000;
        }
    </style>
</head>
<body>

    <!-- Top Navbar -->
    <nav class="navbar navbar-dark bg-dark fixed-top">
    <div class="container-fluid">
        <a class="navbar-brand">My Website</a>
        <span class="text-white">Welcome, <%= Session["Username"] ?? "Guest" %>!</span>
        <form runat="server">
            <asp:Button ID="btnLogout" runat="server" CssClass="btn btn-danger btn-sm" 
                        Text="Logout" OnClick="btnLogout_Click" />
        </form>
    </div>
</nav>

    <!-- Sidebar -->
    <div class="sidebar">
        <a href="Home.aspx">🏠 Home</a>
        <a href="About.aspx">ℹ️ About</a>
        <a href="Services.aspx">🛠 Services</a>
        <a href="Contact.aspx">📞 Contact</a>
        <a href="Logout.aspx">🚪 Logout</a>
    </div>

    <!-- Main Content Area -->
    <div class="content">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
    </div>

</body>
</html>