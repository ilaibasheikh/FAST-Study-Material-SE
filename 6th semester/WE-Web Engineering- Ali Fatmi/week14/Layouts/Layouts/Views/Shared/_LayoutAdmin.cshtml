@{
    Layout = null;
    var username = Session["Username"] as string;
}
<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <header class="bg-dark text-white p-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold">MyApp Admin</span>
        <div>
            @if (!string.IsNullOrEmpty(username))
            {
                <span class="me-3">Welcome, @username</span>
                @Html.ActionLink("Logout", "Logout", "Account", null, new { @class = "btn btn-outline-light btn-sm" })
            }
        </div>
    </header>

    <div class="d-flex">
        <nav class="bg-light p-3" style="width: 200px;">
            <ul class="nav flex-column">
                <li class="nav-item">@Html.ActionLink("Dashboard", "Index", "Admin", new { }, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Users", "Index", "Users", new { }, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Reports", "Index", "Reports", new { }, new { @class = "nav-link" })</li>
            </ul>
        </nav>

        <main class="p-4 w-100">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white text-center p-2 mt-auto">
        &copy; 2025 MyApp - Admin Panel
    </footer>
</body>
</html>
