@{
    Layout = null;
    var username = Session["Username"] as string;
}
<!DOCTYPE html>
<html>
<head>
    <title>User Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <header class="bg-primary text-white p-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold">MyApp User</span>
        <div>
            @if (!string.IsNullOrEmpty(username))
            {
                <span class="me-3">Hello, @username</span>
                @Html.ActionLink("Logout", "Logout", "Account", null, new { @class = "btn btn-outline-light btn-sm" })
            }
        </div>
    </header>

    <div class="d-flex">
        <nav class="bg-light p-3" style="width: 200px;">
            <ul class="nav flex-column">
                <li class="nav-item">@Html.ActionLink("Home", "Index", "Home", new { }, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Profile", "Profile", "User", new { }, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Orders", "Orders", "User", new { }, new { @class = "nav-link" })</li>
            </ul>
        </nav>

        <main class="p-4 w-100">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-primary text-white text-center p-2 mt-auto">
        &copy; 2025 MyApp - User Panel
    </footer>
</body>
</html>
