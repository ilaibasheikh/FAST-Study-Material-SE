@{
    ViewData["Title"] = ViewData["Title"] ?? "Default Title";
    Layout = null; // Remove this line if using _Layout.cshtml
}

<h1>@ViewData["Title"]</h1>
<ul>
    @{
        var items = ViewData["Items"] as List<string>;
    }
    @if (items != null)
    {
        foreach (var item in items)
        {
            <li>@item</li>
        }
    }
</ul>